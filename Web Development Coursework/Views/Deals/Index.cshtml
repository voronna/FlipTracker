@model Web_Development_Coursework.Controllers.DealsIndexViewModel
@using Web_Development_Coursework.Models

@{
    ViewData["Title"] = "My deals";
}

@functions {
    string StatusBadge(DealStatus s) => s switch
    {
        DealStatus.Bought => "bg-info text-dark",
        DealStatus.InProgress => "bg-warning text-dark",
        DealStatus.Sold => "bg-success",
        _ => "bg-light text-dark border"
    };
}

<h1>My deals</h1>

<section aria-labelledby="funnel-heading" class="mb-4">
    <h2 id="funnel-heading" class="h5">Funnel</h2>
    <div class="row row-cols-2 row-cols-md-4 g-3">
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6">@Model.FoundCount</div>
                    <div class="text-muted">Found (no deal yet)</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6">@Model.BoughtCount</div>
                    <div class="text-muted">Bought</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6">@Model.InProgressCount</div>
                    <div class="text-muted">In progress</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6">@Model.SoldCount</div>
                    <div class="text-muted">Sold</div>
                </div>
            </div>
        </div>
    </div>
    <p class="mt-3 mb-0">
        Total profit on sold deals:
        <strong>@(Model.TotalProfit >= 0 ? "+" : "")@Model.TotalProfit.ToString("0.00") EUR</strong>
        @if (Model.AverageRoi.HasValue)
        {
            <span> &middot; average ROI: <strong>@Model.AverageRoi.Value.ToString("0")%</strong></span>
        }
    </p>
</section>

@if (!Model.Deals.Any())
{
    <p class="text-muted">
        No deals yet. Open a listing and choose "Track as deal" after you buy it.
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Listing</th>
                    <th>Status</th>
                    <th>Buy price</th>
                    <th>Extra costs</th>
                    <th>Sell price</th>
                    <th>Profit</th>
                    <th>ROI</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Deals)
                {
                    <tr>
                        <td>@d.Listing?.Model?.Name</td>
                        <td>@d.Listing?.Title</td>
                        <td><span class="badge @StatusBadge(d.Status)">@(d.Status == DealStatus.InProgress ? "In progress" : d.Status.ToString())</span></td>
                        <td>@d.BuyPrice.ToString("0.00")</td>
                        <td>@d.ExtraCosts.ToString("0.00")</td>
                        <td>@(d.SellPrice.HasValue ? d.SellPrice.Value.ToString("0.00") : "-")</td>
                        <td>
                            @if (d.Profit.HasValue)
                            {
                                <span class="@(d.Profit >= 0 ? "text-success" : "text-danger")">@(d.Profit >= 0 ? "+" : "")@d.Profit.Value.ToString("0.00")</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>@(d.RoiPct.HasValue ? d.RoiPct.Value.ToString("0") + "%" : "-")</td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@d.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this deal?');">
                                <button type="submit" class="btn btn-link p-0 ms-2 align-baseline">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
